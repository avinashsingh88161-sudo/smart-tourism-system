<% layout('layouts/boilerplate') %>

<% if (!listing) { %>
  <div class="container mt-4">
    <div class="alert alert-danger">
      <h4>Error: Listing not found</h4>
      <p>The listing you're looking for doesn't exist or has been removed.</p>
      <a href="/listings" class="btn btn-primary">Go to Listings</a>
    </div>
  </div>
<% } else { %>

<div class="container mt-4 mb-5">
  <div class="row g-4">
    <!-- LEFT COLUMN: Listing Details & Reviews -->
    <div class="col-lg-7">
      <div class="card listing-card shadow-sm border-0 rounded-4 overflow-hidden mb-4">
        <img
          src="<%= listing.image.url || listing.image %>"
          class="card-img-top show-image"
          style="height: 380px; object-fit: cover;"
          alt="<%= listing.title %>"
        />

        <div class="card-body p-4">
          <div class="d-flex justify-content-between align-items-center mb-2">
            <span class="badge bg-light text-dark border px-3 py-2 rounded-pill">
              <i class="fa-solid fa-user-circle text-danger me-1"></i> Hosted by <%= (listing.owner && listing.owner.username) ? listing.owner.username : "Owner" %>
            </span>
            <span class="text-muted small">
              <i class="fa-solid fa-location-dot text-danger me-1"></i> <%= listing.location %>, <%= listing.country %>
            </span>
          </div>

          <h2 class="fw-bold text-dark mb-3"><%= listing.title %></h2>
          <p class="text-secondary lead fs-6 mb-4"><%= listing.description %></p>

          <div class="border-top pt-3 d-flex flex-wrap gap-4 text-muted small">
            <div><i class="fa-solid fa-wifi text-danger me-1"></i> Free High-Speed WiFi</div>
            <div><i class="fa-solid fa-square-parking text-danger me-1"></i> Free Parking</div>
            <div><i class="fa-solid fa-mug-hot text-danger me-1"></i> Breakfast Available</div>
          </div>
        </div>
      </div>

      <!-- Owner Actions -->
      <% if(currentUser && listing.owner && currentUser._id.equals(listing.owner._id)) { %>
        <div class="d-flex gap-2 mb-4">
          <a href="/listings/<%= listing._id %>/edit" class="btn btn-outline-dark px-4 rounded-pill">
            <i class="fas fa-edit me-1"></i> Edit Listing
          </a>
          <form action="/listings/<%= listing._id %>?_method=DELETE" method="POST" style="display: inline;">
            <button type="submit" class="btn btn-outline-danger px-4 rounded-pill" onclick="return confirm('Are you sure you want to delete this listing?')">
              <i class="fas fa-trash me-1"></i> Delete
            </button>
          </form>
        </div>
      <% } %>

      <!-- Reviews Section -->
      <div class="card border-0 shadow-sm rounded-4 p-4 mb-4">
        <h4 class="fw-bold mb-4">Customer Reviews (<%= listing.reviews.length %>)</h4>

        <% if(currentUser){ %>
          <div class="bg-light p-3 rounded-3 mb-4">
            <h5 class="fs-6 fw-bold mb-3">Leave a Review</h5>
            <form action="/listings/<%= listing._id %>/reviews" method="POST" class="needs-validation" novalidate>
              <div class="mb-3">
                <fieldset class="starability-slot">
                  <legend class="fs-6">Rating:</legend>
                  <input type="radio" id="rate1" name="review[rating]" value="1" required />
                  <label for="rate1" title="Terrible">1 star</label>
                  <input type="radio" id="rate2" name="review[rating]" value="2" />
                  <label for="rate2" title="Not good">2 stars</label>
                  <input type="radio" id="rate3" name="review[rating]" value="3" />
                  <label for="rate3" title="Average">3 stars</label>
                  <input type="radio" id="rate4" name="review[rating]" value="4" />
                  <label for="rate4" title="Very good">4 stars</label>
                  <input type="radio" id="rate5" name="review[rating]" value="5" />
                  <label for="rate5" title="Amazing">5 stars</label>
                </fieldset>
              </div>

              <div class="mb-3">
                <label for="reviewComment" class="form-label small fw-bold">Comments:</label>
                <textarea id="reviewComment" name="review[comment]" class="form-control" rows="3" required placeholder="Share your experience..."></textarea>
                <div class="invalid-feedback">Please enter a review comment.</div>
              </div>

              <button type="submit" class="btn btn-dark btn-sm rounded-pill px-4">Submit Review</button>
            </form>
          </div>
        <% } else { %>
          <div class="alert alert-light border text-center mb-4">
            <i class="fa-solid fa-lock text-muted me-1"></i> <a href="/login" class="text-danger fw-bold">Log in</a> to leave a review.
          </div>
        <% } %>

        <% if(listing.reviews && listing.reviews.length > 0) { %>
          <% for(review of listing.reviews){ %>
            <div class="border-bottom pb-3 mb-3">
              <div class="d-flex justify-content-between align-items-center mb-1">
                <span class="fw-bold text-dark">
                  @<%= (review.author && review.author.username) ? review.author.username : "Anonymous" %>
                </span>
                <div class="starability-result" data-rating="<%= review.rating %>"></div>
              </div>
              <p class="text-secondary mb-2 small"><%= review.comment %></p>
              <% if(currentUser && review.author && currentUser._id.equals(review.author._id)) { %>
                <form action="/listings/<%= listing._id %>/reviews/<%= review._id %>?_method=DELETE" method="POST" style="display: inline;">
                  <button class="btn btn-sm text-danger p-0 border-0 bg-transparent small" onclick="return confirm('Delete review?')">
                    <i class="fa-solid fa-trash me-1"></i> Delete
                  </button>
                </form>
              <% } %>
            </div>
          <% } %>
        <% } else { %>
          <p class="text-muted small mb-0 text-center py-3">No reviews yet for this destination. Be the first to share your thoughts!</p>
        <% } %>
      </div>
    </div>

    <!-- RIGHT COLUMN: Hotel/Property Booking Widget Card -->
    <div class="col-lg-5">
      <div class="booking-widget-card sticky-top" style="top: 6rem; z-index: 10;">
        <div class="d-flex justify-content-between align-items-baseline mb-3 pb-3 border-bottom">
          <div>
            <span class="booking-price-header" id="bookingPricePerNight" data-price="<%= listing.price %>">
              &#8377; <%= listing.price.toLocaleString("en-IN") %>
            </span>
            <span class="text-muted"> / night</span>
          </div>
          <span class="badge bg-success-subtle text-success border border-success-subtle px-3 py-2 rounded-pill small">
            <i class="fa-solid fa-circle-check me-1"></i> Instant Booking
          </span>
        </div>

        <h5 class="fw-bold mb-3"><i class="fa-solid fa-calendar-check text-danger me-2"></i>Reserve Property</h5>

        <% if(!currentUser) { %>
          <div class="alert alert-warning border-0 bg-warning-subtle text-warning-emphasis mb-3">
            <i class="fa-solid fa-circle-info me-1"></i> Please log in to complete your reservation.
          </div>
        <% } %>

        <form action="/listings/<%= listing._id %>/bookings" method="POST" id="propertyBookingForm" class="needs-validation" novalidate>
          <div class="row g-2 mb-3">
            <div class="col-6">
              <label for="checkInDate" class="form-label small fw-bold">Check-In</label>
              <input type="date" class="form-control" id="checkInDate" name="checkInDate" required />
              <div class="invalid-feedback">Select check-in date.</div>
            </div>
            <div class="col-6">
              <label for="checkOutDate" class="form-label small fw-bold">Check-Out</label>
              <input type="date" class="form-control" id="checkOutDate" name="checkOutDate" required />
              <div class="invalid-feedback">Select check-out date.</div>
            </div>
          </div>

          <div class="row g-2 mb-3">
            <div class="col-6">
              <label for="numberOfGuests" class="form-label small fw-bold">Guests</label>
              <input type="number" class="form-control" id="numberOfGuests" name="numberOfGuests" min="1" max="10" value="1" required />
            </div>
            <div class="col-6">
              <label for="numberOfRooms" class="form-label small fw-bold">Rooms</label>
              <input type="number" class="form-control" id="numberOfRooms" name="numberOfRooms" min="1" max="5" value="1" required />
            </div>
          </div>

          <div class="mb-3">
            <label for="guestName" class="form-label small fw-bold">Guest Name</label>
            <input type="text" class="form-control" id="guestName" name="guestName" value="<%= currentUser ? currentUser.username : '' %>" placeholder="Full name" required />
          </div>

          <div class="row g-2 mb-3">
            <div class="col-6">
              <label for="email" class="form-label small fw-bold">Email</label>
              <input type="email" class="form-control" id="email" name="email" value="<%= currentUser ? currentUser.email : '' %>" placeholder="Email address" required />
            </div>
            <div class="col-6">
              <label for="phone" class="form-label small fw-bold">Phone</label>
              <input type="tel" class="form-control" id="phone" name="phone" value="<%= (currentUser && currentUser.phone) ? currentUser.phone : '' %>" placeholder="Phone number" required />
            </div>
          </div>

          <div class="mb-3">
            <label for="specialRequest" class="form-label small fw-bold">Special Requests (Optional)</label>
            <textarea class="form-control" id="specialRequest" name="specialRequest" rows="2" placeholder="e.g. Quiet room, late check-in"></textarea>
          </div>

          <!-- Dynamic Calculation Summary Box -->
          <div class="booking-summary-box mb-3" id="bookingSummaryBox" style="display: none;">
            <div class="summary-line">
              <span>&#8377; <%= listing.price.toLocaleString("en-IN") %> × <span id="calcNightsCount">0 Nights</span></span>
              <span id="calcSubtotal">&#8377; 0</span>
            </div>
            <div class="summary-line">
              <span>Taxes & Fees (18% GST)</span>
              <span id="calcTax">&#8377; 0</span>
            </div>
            <div class="summary-line total">
              <span>Total Price</span>
              <span class="text-danger" id="calcTotalAmount">&#8377; 0</span>
            </div>
          </div>

          <% if(currentUser) { %>
            <button type="submit" class="auth-submit-btn border-0 w-100" id="confirmBookingBtn">
              <i class="fa-solid fa-lock me-1"></i> Book Now
            </button>
          <% } else { %>
            <a href="/login" class="btn btn-outline-danger w-100 py-2 rounded-3 fw-bold">
              <i class="fa-solid fa-right-to-bracket me-1"></i> Log In to Book
            </a>
          <% } %>
        </form>
      </div>
    </div>
  </div>
</div>

<script src="/js/booking.js"></script>
<% } %>
