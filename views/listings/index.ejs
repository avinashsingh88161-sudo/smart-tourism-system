<% layout('layouts/boilerplate') %> 

<div class="container-fluid px-lg-5 px-3">
  <!-- CATEGORY FILTER BAR & TAX TOGGLE -->
  <div class="d-flex align-items-center justify-content-between my-3 gap-3">
    <div class="category-filter-bar flex-grow-1" id="categoryFilterBar">
      <a href="/listings" class="category-item active">
        <div class="category-icon"><i class="fa-solid fa-fire"></i></div>
        <span class="category-name">Trending</span>
      </a>
      <a href="/listings?category=Bed%20%26%20Breakfast" class="category-item">
        <div class="category-icon"><i class="fa-solid fa-bed"></i></div>
        <span class="category-name">Bed & Breakfast</span>
      </a>
      <a href="/listings?category=Iconic%20city" class="category-item">
        <div class="category-icon"><i class="fa-solid fa-city"></i></div>
        <span class="category-name">Iconic City</span>
      </a>
      <a href="/listings?category=Mountains" class="category-item">
        <div class="category-icon"><i class="fa-solid fa-mountain"></i></div>
        <span class="category-name">Mountains</span>
      </a>
      <a href="/listings?category=Castle" class="category-item">
        <div class="category-icon"><i class="fa-solid fa-chess-rook"></i></div>
        <span class="category-name">Castle</span>
      </a>
      <a href="/listings?category=Amazing%20pool" class="category-item">
        <div class="category-icon"><i class="fa-solid fa-water-ladder"></i></div>
        <span class="category-name">Amazing Pool</span>
      </a>
      <a href="/listings?category=Campground" class="category-item">
        <div class="category-icon"><i class="fa-solid fa-campground"></i></div>
        <span class="category-name">Campground</span>
      </a>
      <a href="/listings?category=Farm%20stay" class="category-item">
        <div class="category-icon"><i class="fa-solid fa-wheat-awn"></i></div>
        <span class="category-name">Farm Stay</span>
      </a>
      <a href="/listings?category=Arctic" class="category-item">
        <div class="category-icon"><i class="fa-solid fa-snowflake"></i></div>
        <span class="category-name">Arctic</span>
      </a>
      <a href="/listings?category=Doms" class="category-item">
        <div class="category-icon"><i class="fa-solid fa-igloo"></i></div>
        <span class="category-name">Doms</span>
      </a>
      <a href="/listings?category=Boats" class="category-item">
        <div class="category-icon"><i class="fa-solid fa-sailboat"></i></div>
        <span class="category-name">Boats</span>
      </a>
    </div>

    <!-- Display Taxes Toggle Switch Pill -->
    <div class="tax-switch-card">
      <div class="form-check form-switch mb-0 d-flex align-items-center gap-2">
        <input class="form-check-input mt-0" type="checkbox" role="switch" id="taxSwitch">
        <label class="form-check-label mb-0 cursor-pointer" for="taxSwitch">Display total with taxes</label>
      </div>
    </div>
  </div>

  <!-- LISTINGS GRID -->
  <div class="row row-cols-xl-4 row-cols-lg-3 row-cols-md-2 row-cols-1 g-4 mb-5">
    <% for(let listing of allListings){ %>
      <div class="col">
        <a href="/listings/<%= listing._id %>" class="text-decoration-none text-dark">
          <div class="card h-100 listing-card-modern">
            <div class="listing-img-wrapper">
              <img 
                src="<%= listing.image.url || listing.image %>" 
                class="card-img-top" 
                style="height: 18.5rem; object-fit: cover;"
                alt="<%= listing.title %>"
              />
              <button class="heart-fav-btn" title="Add to Wishlist" type="button">
                <i class="fa-regular fa-heart"></i>
              </button>
            </div>

            <div class="card-body p-3">
              <div class="d-flex justify-content-between align-items-baseline mb-1">
                <h6 class="fw-bold mb-0 text-truncate text-dark" style="max-width: 80%;"><%= listing.title %></h6>
                <span class="small fw-semibold text-dark"><i class="fa-solid fa-star text-warning me-1"></i>4.9</span>
              </div>
              <p class="text-muted small mb-2 text-truncate"><%= listing.location %>, <%= listing.country %></p>
              
              <div class="d-flex align-items-baseline gap-1">
                <span class="fw-bold fs-6 text-dark">&#8377; <%= listing.price.toLocaleString("en-IN") %></span>
                <span class="text-secondary small">/ night</span>
                <span class="tax-info text-danger small fw-semibold ms-1" style="display: none;">+ 18% GST</span>
              </div>
            </div>
          </div>
        </a>
      </div>
    <% } %>
  </div>
</div>  

<script>
  document.addEventListener("DOMContentLoaded", function() {
    const taxSwitch = document.getElementById("taxSwitch");
    if (taxSwitch) {
      taxSwitch.addEventListener("change", function() {
        const taxElements = document.querySelectorAll(".tax-info");
        taxElements.forEach(el => {
          el.style.display = this.checked ? "inline" : "none";
        });
      });
    }
  });
</script>