<% layout('layouts/boilerplate') %>

<div class="container my-5">
  <div class="confirmation-card">
    <div class="confirmation-header">
      <div class="confirmation-icon">
        <i class="fa-solid fa-circle-check"></i>
      </div>
      <h2 class="fw-bold mb-1">Booking Confirmed!</h2>
      <p class="text-light opacity-75 mb-0">Your reservation has been successfully placed.</p>
    </div>

    <div class="p-4 p-md-5 bg-white">
      <div class="d-flex justify-content-between align-items-center mb-4 pb-3 border-bottom flex-wrap gap-2">
        <div>
          <span class="text-muted small d-block">Booking ID</span>
          <span class="fs-5 fw-bold text-dark"><%= booking.bookingId %></span>
        </div>
        <div>
          <span class="badge badge-status badge-status-<%= booking.bookingStatus.toLowerCase() %> fs-6 px-3 py-2">
            Status: <%= booking.bookingStatus %>
          </span>
        </div>
      </div>

      <div class="row g-4 mb-4">
        <!-- Property Info -->
        <div class="col-md-6">
          <h6 class="fw-bold text-muted text-uppercase mb-3 small"><i class="fa-solid fa-hotel me-1 text-danger"></i> Property Details</h6>
          <div class="d-flex align-items-center gap-3 bg-light p-3 rounded-3">
            <% if(booking.listing && booking.listing.image) { %>
              <img src="<%= booking.listing.image.url || booking.listing.image %>" class="rounded-3" style="width: 80px; height: 70px; object-fit: cover;" alt="<%= booking.listing.title %>" />
            <% } %>
            <div>
              <h6 class="fw-bold text-dark mb-1"><%= booking.listing ? booking.listing.title : "Property" %></h6>
              <p class="small text-muted mb-0"><i class="fa-solid fa-location-dot me-1"></i> <%= booking.listing ? booking.listing.location : "" %></p>
            </div>
          </div>
        </div>

        <!-- Guest Info -->
        <div class="col-md-6">
          <h6 class="fw-bold text-muted text-uppercase mb-3 small"><i class="fa-solid fa-user me-1 text-danger"></i> Guest Details</h6>
          <div class="bg-light p-3 rounded-3">
            <p class="mb-1 small"><strong>Name:</strong> <%= booking.guestName %></p>
            <p class="mb-1 small"><strong>Email:</strong> <%= booking.email %></p>
            <p class="mb-0 small"><strong>Phone:</strong> <%= booking.phone %></p>
          </div>
        </div>
      </div>

      <!-- Stay Summary -->
      <div class="card border-0 bg-light rounded-3 p-4 mb-4">
        <h6 class="fw-bold text-muted text-uppercase mb-3 small"><i class="fa-solid fa-calendar-days me-1 text-danger"></i> Stay Summary</h6>
        <div class="row text-center g-3">
          <div class="col-4 border-end">
            <span class="text-muted small d-block">Check-In</span>
            <strong class="text-dark"><%= new Date(booking.checkInDate).toLocaleDateString('en-IN', { day: 'numeric', month: 'short', year: 'numeric' }) %></strong>
          </div>
          <div class="col-4 border-end">
            <span class="text-muted small d-block">Check-Out</span>
            <strong class="text-dark"><%= new Date(booking.checkOutDate).toLocaleDateString('en-IN', { day: 'numeric', month: 'short', year: 'numeric' }) %></strong>
          </div>
          <div class="col-4">
            <span class="text-muted small d-block">Duration</span>
            <strong class="text-dark"><%= booking.numberOfNights %> Night(s)</strong>
          </div>
        </div>
      </div>

      <!-- Payment Breakdown -->
      <div class="bg-light p-4 rounded-3 mb-4">
        <h6 class="fw-bold text-muted text-uppercase mb-3 small"><i class="fa-solid fa-receipt me-1 text-danger"></i> Payment Summary</h6>
        <div class="d-flex justify-content-between mb-2 small text-secondary">
          <span>Rate per night</span>
          <span>&#8377; <%= booking.pricePerNight.toLocaleString("en-IN") %></span>
        </div>
        <div class="d-flex justify-content-between mb-2 small text-secondary">
          <span>Subtotal (<%= booking.numberOfNights %> nights × <%= booking.numberOfRooms %> rooms)</span>
          <span>&#8377; <%= booking.subtotal.toLocaleString("en-IN") %></span>
        </div>
        <div class="d-flex justify-content-between mb-2 small text-secondary">
          <span>Taxes & Fees (18% GST)</span>
          <span>&#8377; <%= booking.tax.toLocaleString("en-IN") %></span>
        </div>
        <div class="d-flex justify-content-between pt-2 border-top fw-bold fs-5 text-dark">
          <span>Total Amount</span>
          <span class="text-danger">&#8377; <%= booking.totalAmount.toLocaleString("en-IN") %></span>
        </div>
      </div>

      <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
        <a href="/bookings" class="btn btn-outline-dark rounded-pill px-4">
          <i class="fa-solid fa-suitcase me-1"></i> View My Bookings
        </a>
        <a href="/listings" class="btn btn-danger rounded-pill px-4">
          <i class="fa-solid fa-compass me-1"></i> Explore More Destinations
        </a>
      </div>
    </div>
  </div>
</div>
